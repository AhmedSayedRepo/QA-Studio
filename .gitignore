# Python
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
.eggs/
build/
dist/
*.spec

# Virtual envs
venv/
.venv/
env/

# Credentials (NEVER commit these)
*.dat
creds.dat
.qa_tool/
gh_token.txt

# OS
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/
.idea/
*.swp

# Flet build output
build/
storage/

# Downloaded/built APK artifacts — never commit binaries (exceeds GitHub 100MB
# limit and breaks `git add -A` pushes in build-apk.bat / release flows).
apk-out/
apk_out/
*.apk

# Logs (may contain tokens/PII — never commit)
*.log

# Performance-test generated artifacts (emitted JMeter projects / run output)
perf_out/
qastudio_perf/

# Local recovery and diagnostics
_to_delete/
supabase/_migration_hold/
_perf_english.json
